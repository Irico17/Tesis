  form.addSectionHeaderItem().setTitle("Reporte del sistema: correo 1").setHelpText("Este correo fue clasificado como phishing con una confianza del 99.6%. Los factores que más influyeron en la decisión fueron: la palabra \"inbox\" (peso 1.4%), la palabra \"transffered\" (peso 0.9%), la palabra \"authomated\" (peso 0.9%). Explicación generada mediante los pesos de atención intrínseca del modelo.\n\nVEREDICTO: PHISHING (confianza 99.6%)\nTécnica de explicabilidad: los pesos de atención intrínseca del modelo\n\n[Contenido textual (semántica del mensaje)] — contribución agregada: 100.0%\n  · la palabra \"inbox\": 29.9%\n  · la palabra \"transffered\": 19.6%\n  · la palabra \"authomated\": 19.1%\n  · una cifra \"0514\": 16.4%\n  · la palabra \"your\": 15.0%\n\n[Estructura HTML/DOM] — sin peso en esta decisión\n\n[Metadatos de red y autenticación] — sin peso en esta decisión\n\nSÍNTESIS: La clasificación como phishing se apoya principalmente en la modalidad 'Contenido textual (semántica del mensaje)' (100.0% del peso total de la decisión).");
  item = form.addMultipleChoiceItem();
  item.setTitle("C1. Según el reporte, ¿qué palabra tuvo mayor peso en la clasificación de este correo como phishing?").setChoiceValues(["account", "transffered", "inbox", "payment"]).setRequired(true);
  item = form.addMultipleChoiceItem();
  item.setTitle("C2. Según el reporte, la estructura HTML del correo pesó más que su contenido textual en esta decisión.").setChoiceValues(["Verdadero", "Falso"]).setRequired(true);
  item = form.addMultipleChoiceItem();
  item.setTitle("C3. Según el reporte, ¿con qué nivel de confianza clasificó el sistema este correo?").setChoiceValues(["Menos del 60%", "Entre 60% y 90%", "Entre 90% y 99%", "Más del 99%"]).setRequired(true);
  form.addPageBreakItem().setTitle("Sección C. Comprensión: correo 2 de 4");
  form.addImageItem().setTitle("Correo 2").setHelpText("Asunto: Re: how to enable/start \"git@.service\" via systemd?").setImage(UrlFetchApp.fetch("https://raw.githubusercontent.com/Irico17/Tesis/master/doc/validacion_xai/formulario/resaltado_legitimo_1.png"));
  form.addSectionHeaderItem().setTitle("Reporte del sistema: correo 2").setHelpText("Este correo fue clasificado como legítimo con una confianza del 100.0%. Los factores que más influyeron en la decisión fueron: la palabra \"fedora\" (peso 1.4%), la palabra \"invocations\" (peso 0.4%), la palabra \"wrote\" (peso 0.4%). Explicación generada mediante los pesos de atención intrínseca del modelo.\n\nVEREDICTO: LEGÍTIMO (confianza 100.0%)\nTécnica de explicabilidad: los pesos de atención intrínseca del modelo\n\n[Contenido textual (semántica del mensaje)] — contribución agregada: 100.0%\n  · la palabra \"fedora\": 45.0%\n  · la palabra \"invocations\": 14.8%\n  · la palabra \"wrote\": 14.7%\n  · la palabra \"libexec\": 13.0%\n  · una abreviatura \"cdt\": 12.6%\n\n[Estructura HTML/DOM] — sin peso en esta decisión\n\n[Metadatos de red y autenticación] — sin peso en esta decisión\n\nSÍNTESIS: La clasificación como legítimo se apoya principalmente en la modalidad 'Contenido textual (semántica del mensaje)' (100.0% del peso total de la decisión).");
  item = form.addMultipleChoiceItem();
  item.setTitle("C4. Según el reporte, ¿qué palabra contribuyó más a que el sistema considerara legítimo este correo?").setChoiceValues(["socket", "fedora", "daemon", "invocations"]).setRequired(true);
  item = form.addMultipleChoiceItem();
  item.setTitle("C5. Según el reporte, la decisión sobre este correo se apoyó principalmente en su contenido textual.").setChoiceValues(["Verdadero", "Falso"]).setRequired(true);
  form.addPageBreakItem().setTitle("Sección C. Comprensión: correo 3 de 4");
  form.addImageItem().setTitle("Correo 3").setHelpText("Asunto: RE: ITS HELP DESK: PASSWORD UPDATE").setImage(UrlFetchApp.fetch("https://raw.githubusercontent.com/Irico17/Tesis/master/doc/validacion_xai/formulario/resaltado_phishing_2.png"));
  form.addSectionHeaderItem().setTitle("Reporte del sistema: correo 3").setHelpText("Este correo fue clasificado como phishing con una confianza del 95.6%. Los factores que más influyeron en la decisión fueron: un signo de puntuación \"*\" (peso 0.9%), la palabra \"expires\" (peso 0.8%), la palabra \"account\" (peso 0.8%). Explicación generada mediante los pesos de atención intrínseca del modelo.\n\nVEREDICTO: PHISHING (confianza 95.6%)\nTécnica de explicabilidad: los pesos de atención intrínseca del modelo\n\n[Contenido textual (semántica del mensaje)] — contribución agregada: 99.6%\n  · un signo de puntuación \"*\": 23.3%\n  · la palabra \"expires\": 20.5%\n  · la palabra \"account\": 20.3%\n  · la palabra \"helpdesk\": 18.1%\n  · la palabra \"the\": 17.5%\n\n[Estructura HTML/DOM] — sin peso en esta decisión\n\n[Metadatos de red y autenticación] — contribución agregada: 0.4%\n  · la cantidad de subdominios en las URLs: 0.2%\n  · la cantidad de URLs reportadas: 0.1%\n\nSÍNTESIS: La clasificación como phishing se apoya principalmente en la modalidad 'Contenido textual (semántica del mensaje)' (99.6% del peso total de la decisión).");
  item = form.addMultipleChoiceItem();
  item.setTitle("C6. Según el reporte, ¿cuál de estas características de la estructura HTML o de la red influyó en la decisión sobre este correo?").setChoiceValues(["la cantidad de enlaces", "el uso de un acortador de enlaces", "la longitud del mensaje", "la cantidad de subdominios en las URLs"]).setRequired(true);
  item = form.addMultipleChoiceItem();
  item.setTitle("C7. Según el reporte, en el bloque de texto «helpdesk» tuvo más peso que «expires».").setChoiceValues(["Verdadero", "Falso"]).setRequired(true);
  form.addPageBreakItem().setTitle("Sección C. Comprensión: correo 4 de 4");
  form.addImageItem().setTitle("Correo 4").setHelpText("Asunto: Mysterious autostart behaviour").setImage(UrlFetchApp.fetch("https://raw.githubusercontent.com/Irico17/Tesis/master/doc/validacion_xai/formulario/resaltado_legitimo_2.png"));
  form.addSectionHeaderItem().setTitle("Reporte del sistema: correo 4").setHelpText("Este correo fue clasificado como legítimo con una confianza del 100.0%. Los factores que más influyeron en la decisión fueron: la palabra \"kde\" (peso 1.9%), la palabra \"qbittorrent\" (peso 1.7%), la palabra \"poc\" (peso 1.5%). Explicación generada mediante los pesos de atención intrínseca del modelo.\n\nVEREDICTO: LEGÍTIMO (confianza 100.0%)\nTécnica de explicabilidad: los pesos de atención intrínseca del modelo\n\n[Contenido textual (semántica del mensaje)] — contribución agregada: 100.0%\n  · la palabra \"kde\": 23.9%\n  · la palabra \"qbittorrent\": 21.8%\n  · la palabra \"poc\": 19.0%\n  · la palabra \"autostart\": 17.8%\n  · la palabra \"ktorrent\": 17.4%\n\n[Estructura HTML/DOM] — sin peso en esta decisión\n\n[Metadatos de red y autenticación] — sin peso en esta decisión\n\nSÍNTESIS: La clasificación como legítimo se apoya principalmente en la modalidad 'Contenido textual (semántica del mensaje)' (100.0% del peso total de la decisión).");
  item = form.addMultipleChoiceItem();
  item.setTitle("C8. Según el reporte, ¿qué decidió el sistema sobre este correo?").setChoiceValues(["Legítimo, con entre 60% y 90% de confianza", "Phishing, con más del 99% de confianza", "Legítimo, con más del 99% de confianza", "Phishing, con entre 60% y 90% de confianza"]).setRequired(true);
  item = form.addMultipleChoiceItem();
  item.setTitle("C9. ¿Cuál de estas palabras está entre las tres que, según el reporte, más influyeron en la decisión?").setChoiceValues(["around", "listed", "qbittorrent", "anywhere"]).setRequired(true);
  item = form.addMultipleChoiceItem();
  item.setTitle("C10. Según el reporte, la estructura HTML del correo no aportó peso a esta decisión.").setChoiceValues(["Verdadero", "Falso"]).setRequired(true);
  form.addPageBreakItem().setTitle("Sección A. Opinión sobre los reportes (1 de 2)").setHelpText("Piensa en los reportes de explicación que leíste. Para cada afirmación, indica tu grado de acuerdo: 1 = totalmente en desacuerdo, 5 = totalmente de acuerdo. No hay respuestas correctas o incorrectas.");
  item = form.addGridItem();
  item.setTitle("Grado de acuerdo (1 a 5)").setRows(["A1. Creo que usaría este reporte de explicación con frecuencia si tuviera que revisar correos sospechosos regularmente.", "A2. Encontré que este reporte de explicación es innecesariamente complejo.", "A3. Pensé que este reporte de explicación era fácil de entender.", "A4. Creo que necesitaría el apoyo de una persona técnica para poder interpretar este reporte de explicación.", "A5. Encontré que los distintos elementos de este reporte de explicación (factores, pesos, justificación) estaban bien integrados entre sí.", "A6. Pensé que había demasiada inconsistencia en cómo se presenta este reporte de explicación.", "A7. Me imagino que la mayoría de las personas aprendería a interpretar este reporte de explicación muy rápidamente.", "A8. Encontré este reporte de explicación muy engorroso/incómodo de leer.", "A9. Sentí mucha confianza al interpretar este reporte de explicación.", "A10. Necesité aprender muchas cosas antes de poder entender este reporte de explicación."]).setColumns(["1 (totalmente en desacuerdo)", "2", "3", "4", "5 (totalmente de acuerdo)"]).setRequired(true);
  form.addPageBreakItem().setTitle("Sección B. Opinión sobre los reportes (2 de 2)").setHelpText("Las siguientes afirmaciones tratan sobre la utilidad del reporte, la claridad de su información y su presentación. Usa la misma escala de 1 a 5.");
  item = form.addGridItem();
  item.setTitle("Grado de acuerdo (1 a 5)").setRows(["B1. En general, la facilidad de uso de este reporte de explicación me resulta satisfactoria.", "B2. Fue sencillo entender por qué el sistema clasificó el correo como lo hizo, usando este reporte.", "B3. Pude identificar rápidamente los factores clave que llevaron a la clasificación.", "B4. Pude interpretar el reporte de forma eficiente, sin pasos innecesarios.", "B5. Usar este reporte de explicación me resultó cómodo.", "B6. Fue fácil aprender a interpretar este tipo de reporte.", "B7. La información presentada en el reporte (factores, pesos, justificación textual) fue clara.", "B8. Fue fácil encontrar la información que necesitaba dentro del reporte para entender la decisión.", "B9. La información del reporte fue fácil de entender.", "B10. La información fue efectiva para ayudarme a entender por qué el correo fue clasificado así.", "B11. La organización de la información dentro del reporte (orden de los factores, jerarquía de pesos) fue clara.", "B12. Confío en que la información del reporte refleja razones reales de la clasificación, no una justificación genérica.", "B13. La forma en que se presenta visualmente el reporte (formato, íconos, resaltado de factores) fue agradable.", "B14. Me gustó la manera en que el reporte comunica los factores y sus pesos.", "B15. El reporte tiene toda la información que esperaría encontrar en una explicación de este tipo.", "B16. En general, este reporte de explicación me resulta satisfactorio."]).setColumns(["1 (totalmente en desacuerdo)", "2", "3", "4", "5 (totalmente de acuerdo)"]).setRequired(true);
